{
    "name": "pphp/pphp",
    "description": "Un préprocesseur PHP avec typage statique obligatoire, exécuté à la volée.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "pphp",
        "typescript",
        "static-typing",
        "preprocessor",
        "language",
        "compiler",
        "transpiler"
    ],
    "homepage": "https://github.com/JuniorNyemeck/pphp",
    "authors": [
        {
            "name": "Junior Nyemeck",
            "homepage": "https://github.com/JuniorNyemeck"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "PPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PPhp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pphp.php"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
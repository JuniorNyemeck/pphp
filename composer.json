{
    "name": "pphp/pphp",
    "description": "PPHP — un préprocesseur PHP avec typage statique, exécuté à la volée.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "PPhp\\": "src/"
        }
    },
    "bin": ["bin/pphp.php"],
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
    "psr-4": {
        "PPhp\\Tests\\": "tests/"
    }
    }
}

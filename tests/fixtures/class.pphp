<?pphp
class Animal {
    public string $name;

    public function __construct(string $name) {
        $this->name = $name;
    }

    public function speak(): string {
        return "...";
    }
}

class Dog extends Animal {
    public function speak(): string {
        return "Woof!";
    }
}

Animal $a = new Dog("Rex");
echo $a->speak();
echo "\n";
echo $a->name;
echo "\n";